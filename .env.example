# Copie para .env e preencha para rodar localmente com docker compose.
POSTGRES_USER=consominas
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=consominas_gestao
APP_DOMAIN=gestao.consominas.com.br
NEXTAUTH_SECRET=gere-uma-string-aleatoria-longa
RUN_SEED=true
SEED_ADMIN_EMAIL=admin@consominas.com.br
SEED_ADMIN_PASSWORD=troque-esta-senha

# Sincronismo com o Senior (titulos-pagar) e Pagamentos Itau (SISPAG)
# Chave compartilhada que autentica os POSTs de sincronizacao recebidos em
# /api/senior/*/sync (titulos-pagar, aprovacoes, dossies). Usada tanto pelos
# scripts manuais quanto pelos workflows n8n abaixo -- sem ela (ou com valor
# diferente do configurado no n8n), TODA sincronizacao automatica falha em
# silencio com 401 e os dados nunca atualizam.
SENIOR_SYNC_KEY=gere-uma-chave-aleatoria-longa
# Usuario/senha do dispatcher Sapiens (GetDBInfo) -- NAO e a mesma senha do
# Rubi/RH. Desde 12/11/2026 e' com ela que o PROPRIO sistema busca titulos e
# OCs na Senior (botoes "Atualizar agora" e a busca automatica de 10 em 10 min,
# docs/busca-senior-no-appcns.md). Ver GabrielOS/senior_conhecimento_tecnico.md.
SENIOR_WS_SAPIENS_USER=
SENIOR_WS_SAPIENS_PASSWORD=
# Folha (HCM/Rubi), so' leitura: lista de quem ainda trabalha aqui, para a busca
# de OCs nao pedir aprovacao a desligado. Senha PROPRIA do Rubi (diferente da
# do Sapiens). Sem ela a busca funciona e usa a ultima lista conhecida.
SENIOR_WS_HCM_USER=
SENIOR_WS_HCM_PASSWORD=
# SENIOR_WS_HCM_URL=  (padrao: .../g5-senior-services/rubi_Synccom_senior_g5_rh_fp_db)
# Busca automatica de titulos e OCs (so' producao): 0 desliga; intervalo em minutos (minimo 5, padrao 10).
# SENIOR_SYNC_AUTO=1
# SENIOR_SYNC_INTERVALO_MIN=10
# Senior X (eDocs X, notas fiscais recebidas na Conferencia de OC) -- so leitura.
SENIORX_ACCOUNT=
SENIORX_PASSWORD=

# Webhooks do n8n (workflows "Sergio - Titulos a Pagar (Sync)" e "Aprovacoes
# OC (Sync)") -- NAO SAO MAIS USADOS desde 12/11/2026: os botoes "Atualizar
# agora" disparam a busca do proprio sistema. Os workflows do n8n (que rodam
# os scripts do VPS de 10 em 10 min) podem ser desligados depois de conferir
# a busca nova em producao; ate la os dois gravam o mesmo retrato.
TITULOS_SYNC_WEBHOOK_URL=
TITULOS_SYNC_WEBHOOK_SECRET=
OC_SYNC_WEBHOOK_URL=
OC_SYNC_WEBHOOK_SECRET=

# Baixa de titulos na Senior (GerarBaixaPorLoteCP) -- opcional; ja tem o endpoint padrao do tenant.
# Use as mesmas credenciais SENIOR_WS_SAPIENS_*. So' sobrescreva pra apontar a um servidor de teste.
# SENIOR_WS_BAIXA_URL=

# O app confere o retorno Itaú, envia GerarBaixaPorLoteCP após confirmação
# do financeiro e consulta a liquidação antes de atualizar a programação.
# Consulte docs/fluxo-retorno-itau-baixa-senior.md para configuração e validação.
# Sobrescreva também o endpoint de leitura quando usar outro ambiente:
# SENIOR_WS_SAPIENS_URL=
# APP_ENV=homologacao identifica o ambiente visualmente; use o script
# homologacao:preparar para gerar a configuração local com Sênior simulada.
