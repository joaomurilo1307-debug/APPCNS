generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  DIRETOR
  GESTOR_PROJETO
  APROVADOR
  COLABORADOR
  CLIENTE
  VISUALIZADOR
}

enum Horizon {
  H1
  H2
  H3
}

enum NivelHierarquico {
  DIRETORIA
  GERENCIA
  COORDENACAO
  SUPERVISOR
  COLABORADOR
}

enum RiskLevel {
  BAIXO
  MEDIO
  ALTO
}

enum RiskStatus {
  ABERTO
  MITIGADO
  ENCERRADO
}

enum IdeaStatus {
  NOVA
  EM_ANALISE
  APROVADA
  REJEITADA
  CONVERTIDA
}

enum IdeaLevel {
  BAIXO
  MEDIO
  ALTO
}

enum ScorecardScope {
  PESSOAL
  EQUIPE
  PROJETO
  CORPORATIVO
}

enum ScorecardStatusColor {
  VERDE
  AMARELO
  VERMELHO
}

enum NotificationType {
  TAREFA_ATRIBUIDA
  PRAZO_ALTERADO
  TAREFA_ATRASADA
  APROVACAO_PENDENTE
  MENCAO_COMENTARIO
  REUNIAO_PROXIMA
  CONVITE_PROJETO
  OUTRO
}

enum ApprovalStatus {
  NAO_REQUER
  PENDENTE
  APROVADO
  REJEITADO
}

enum TeamRole {
  GESTOR
  MEMBRO
}

enum ProjectStatus {
  PLANEJADO
  EM_ANDAMENTO
  PAUSADO
  CONCLUIDO
}

enum TaskStatus {
  A_FAZER
  FAZENDO
  BLOQUEADO
  FEITO
}

enum TaskPriority {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

enum RotinaFrequencia {
  DIARIA
  SEMANAL
  MENSAL
}

enum EventType {
  REUNIAO
  COMPROMISSO
  ENTREGA
  PRAZO
  OUTRO
}

enum MeetingType {
  ALINHAMENTO
  KICKOFF
  UM_A_UM
  DIRETORIA
  CLIENTE
  TECNICA
  TREINAMENTO
  OUTRA
}

enum OnlineMeetingProvider {
  NENHUM
  TEAMS
  GOOGLE_MEET
  JITSI
}

enum CustomFieldType {
  TEXTO
  NUMERO
  MOEDA
  DATA
  LISTA
  CHECKBOX
  PESSOA
  FORMULA
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         UserRole  @default(COLABORADOR)
  active       Boolean   @default(true)
  avatarColor  String    @default("#0f766e")
  avatarUrl    String?   @db.Text
  lastSeenAt   DateTime?
  statusManual String?
  cargo        String?
  setor        String?
  diretoria    String?
  ramal        String?
  whatsapp     String?
  nivelHierarquico NivelHierarquico?
  nucleoId     String?
  dataInicio   DateTime?
  gestorImediatoId String?
  anonymizedAt DateTime?
  createdAt    DateTime  @default(now())

  gestorImediato  User?      @relation("GestorImediato", fields: [gestorImediatoId], references: [id], onDelete: SetNull)
  subordinados    User[]     @relation("GestorImediato")
  nucleo          Nucleo?    @relation(fields: [nucleoId], references: [id], onDelete: SetNull)

  teams           UserTeam[]
  ownedProjects   Project[]      @relation("ProjectOwner")
  approvingProjects Project[]    @relation("ProjectApprover")
  clientProjects  ProjectClient[]
  assignedTasks   Task[]         @relation("TaskAssignee")
  attachments     Attachment[]
  taskComments    TaskComment[]
  assignedGoals   Goal[]         @relation("GoalAssignees")
  createdEvents   CalendarEvent[]         @relation("EventCreator")
  eventInvites    CalendarEventAttendee[]
  outlookAccount  OutlookAccount?
  sentDirectMessages     DirectMessage[]   @relation("DMSender")
  receivedDirectMessages DirectMessage[]   @relation("DMReceiver")
  teamMessages           TeamMessage[]     @relation("TeamMessageSender")
  teamMessageReads       TeamMessageRead[]
  createdIdeas    Idea[]        @relation("IdeaCreator")
  assignedIdeas   Idea[]        @relation("IdeaAssignee")
  ideaComments    IdeaComment[]
  decisionsMade   Decision[]
  scorecardItems  ScorecardItem[]
  auditLogs       AuditLog[]
  notifications   Notification[]
  resourceRates   ResourceRate[]
  createdFolders  Folder[]  @relation("FolderCreator")
  approvalRequestsSent     ApprovalRequest[] @relation("ApprovalRequester")
  approvalRequestsReceived ApprovalRequest[] @relation("ApprovalApprover")
  pdisAsPessoa  PDI[] @relation("PDIPessoa")
  pdisAsGestor  PDI[] @relation("PDICriador")
  nucleosGerenciados Nucleo[] @relation("NucleoGerente")
  projetosComoDiretor     Project[] @relation("ProjectDiretor")
  projetosComoCoordenador Project[] @relation("ProjectCoordenador")
}

model ApprovalRequest {
  id          String         @id @default(cuid())
  title       String
  description String?        @db.Text
  requesterId String
  approverId  String
  status      ApprovalStatus @default(PENDENTE)
  decidedAt   DateTime?
  createdAt   DateTime       @default(now())

  requester User @relation("ApprovalRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  approver  User @relation("ApprovalApprover", fields: [approverId], references: [id], onDelete: Cascade)

  @@index([approverId, status])
  @@index([requesterId])
}

model DirectMessage {
  id         String    @id @default(cuid())
  senderId   String
  receiverId String
  body       String
  createdAt  DateTime  @default(now())
  readAt     DateTime?

  sender   User @relation("DMSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("DMReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  attachments Attachment[]

  @@index([senderId, receiverId])
  @@index([receiverId, senderId])
}

model TeamMessage {
  id        String   @id @default(cuid())
  teamId    String
  senderId  String
  body      String
  createdAt DateTime @default(now())

  team   Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  sender User @relation("TeamMessageSender", fields: [senderId], references: [id])
  attachments Attachment[]

  @@index([teamId, createdAt])
}

model TeamMessageRead {
  id         String   @id @default(cuid())
  userId     String
  teamId     String
  lastReadAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
}

model OutlookAccount {
  id           String   @id @default(cuid())
  userId       String   @unique
  accessToken  String   @db.Text
  refreshToken String   @db.Text
  expiresAt    DateTime
  msEmail      String?
  deltaLink    String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Team {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  members  UserTeam[]
  projects Project[]
  goals    Goal[]
  messages     TeamMessage[]
  messageReads TeamMessageRead[]
  scorecardItems ScorecardItem[]
  folders      Folder[]
  attachments  Attachment[]
}

model Nucleo {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  membros  User[]
  gerentes User[]    @relation("NucleoGerente")
  projetos Project[] @relation("ProjectNucleo")
}

model UserTeam {
  id     String   @id @default(cuid())
  userId String
  teamId String
  role   TeamRole @default(MEMBRO)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
}

model Project {
  id             String         @id @default(cuid())
  name           String
  description    String?
  status         ProjectStatus  @default(PLANEJADO)
  teamId         String
  ownerId        String
  approverId     String?
  approvalStatus ApprovalStatus @default(NAO_REQUER)
  startDate      DateTime?
  endDate        DateTime?
  actualStartedAt DateTime?
  actualEndedAt   DateTime?
  kanbanColumns  String?        @db.Text
  horizon        Horizon?
  orcamento      Float?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  team     Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  owner    User             @relation("ProjectOwner", fields: [ownerId], references: [id])
  approver User?            @relation("ProjectApprover", fields: [approverId], references: [id])
  clients  ProjectClient[]
  tasks    Task[]
  board    ProjectBoard?
  goals    Goal[]
  events   CalendarEvent[]
  customFields CustomField[]
  milestones Milestone[]
  risks      Risk[]
  decisions  Decision[]
  ideas      Idea[]
  scorecardItems ScorecardItem[]
  resourceRates  ResourceRate[]
  nucleos       Nucleo[] @relation("ProjectNucleo")
  diretores     User[]   @relation("ProjectDiretor")
  coordenadores User[]   @relation("ProjectCoordenador")
  folders       Folder[]
  attachments   Attachment[]

  @@index([teamId])
  @@index([ownerId])
  @@index([status])
}

model ResourceRate {
  id         String @id @default(cuid())
  projectId  String
  userId     String
  hourlyRate Float  @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model Milestone {
  id        String    @id @default(cuid())
  projectId String
  title     String
  dueDate   DateTime?
  done      Boolean   @default(false)
  createdAt DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Risk {
  id             String     @id @default(cuid())
  projectId      String
  title          String
  description    String?    @db.Text
  impact         RiskLevel  @default(MEDIO)
  probability    RiskLevel  @default(MEDIO)
  mitigationPlan String?    @db.Text
  status         RiskStatus @default(ABERTO)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Decision {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  description String?  @db.Text
  decidedById String
  decidedAt   DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  decidedBy User    @relation(fields: [decidedById], references: [id])
}

model Idea {
  id              String     @id @default(cuid())
  projectId       String
  title           String
  description     String?    @db.Text
  category        String?
  status          IdeaStatus @default(NOVA)
  impact          IdeaLevel  @default(MEDIO)
  viability       IdeaLevel  @default(MEDIO)
  urgency         IdeaLevel  @default(MEDIO)
  createdById     String
  assigneeId      String?
  dueDate         DateTime?
  convertedTaskId String?    @unique
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User          @relation("IdeaCreator", fields: [createdById], references: [id])
  assignee  User?         @relation("IdeaAssignee", fields: [assigneeId], references: [id])
  comments  IdeaComment[]

  @@index([projectId, status])
}

model IdeaComment {
  id        String   @id @default(cuid())
  ideaId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  idea   Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])
}

model ScorecardItem {
  id            String               @id @default(cuid())
  scope         ScorecardScope
  teamId        String?
  projectId     String?
  userId        String?
  objective     String
  indicator     String
  target        Float?
  current       Float                @default(0)
  unit          String?
  statusColor   ScorecardStatusColor @default(VERDE)
  trend         String?
  periodicity   String?
  justification String?              @db.Text
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  team    Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([scope])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  metadata   String?  @db.Text
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(OUTRO)
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model CustomField {
  id        String          @id @default(cuid())
  projectId String
  name      String
  type      CustomFieldType
  options   String?         @db.Text
  order     Int             @default(0)
  createdAt DateTime        @default(now())

  project Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  values  TaskCustomFieldValue[]
}

model TaskCustomFieldValue {
  id            String  @id @default(cuid())
  taskId        String
  customFieldId String
  value         String? @db.Text

  task        Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  customField CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)

  @@unique([taskId, customFieldId])
}

model Goal {
  id            String   @id @default(cuid())
  projectId     String?
  title         String
  description   String?
  targetValue   Float?
  currentValue  Float    @default(0)
  unit          String?
  dueDate       DateTime?
  assignedTeamId String?
  parentGoalId  String?
  contributionValue Float?
  autoFromProjectProgress Boolean @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project      Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedUsers User[]  @relation("GoalAssignees")
  assignedTeam Team?   @relation(fields: [assignedTeamId], references: [id])
  parentGoal   Goal?   @relation("GoalHierarchy", fields: [parentGoalId], references: [id], onDelete: SetNull)
  subGoals     Goal[]  @relation("GoalHierarchy")

  @@index([projectId])
  @@index([parentGoalId])
  @@index([assignedTeamId])
}

model PDI {
  id        String   @id @default(cuid())
  userId    String
  gestorId  String
  period    String?
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User      @relation("PDIPessoa", fields: [userId], references: [id], onDelete: Cascade)
  gestor User      @relation("PDICriador", fields: [gestorId], references: [id], onDelete: Cascade)
  items  PDIItem[]

  @@index([userId])
  @@index([gestorId])
}

model PDIItem {
  id          String    @id @default(cuid())
  pdiId       String
  title       String
  description String?
  status      TaskStatus @default(A_FAZER)
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  pdi PDI @relation(fields: [pdiId], references: [id], onDelete: Cascade)

  @@index([pdiId])
}

model CalendarEvent {
  id             String    @id @default(cuid())
  title          String
  description    String?
  type           EventType @default(COMPROMISSO)
  meetingType    MeetingType?
  startAt        DateTime
  endAt          DateTime?
  allDay         Boolean   @default(false)
  projectId      String?
  creatorId      String
  outlookEventId String?   @unique
  onlineMeetingProvider OnlineMeetingProvider @default(NENHUM)
  onlineMeetingUrl      String?               @db.Text
  icsSequence    Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project   Project?                @relation(fields: [projectId], references: [id], onDelete: SetNull)
  creator   User                    @relation("EventCreator", fields: [creatorId], references: [id])
  attendees CalendarEventAttendee[]

  @@index([projectId])
  @@index([creatorId])
  @@index([startAt])
}

model CalendarEventAttendee {
  id     String         @id @default(cuid())
  eventId String
  userId String
  status ApprovalStatus @default(PENDENTE)

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model ProjectBoard {
  id        String   @id @default(cuid())
  projectId String   @unique
  content   String   @db.Text
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectClient {
  id        String @id @default(cuid())
  projectId String
  userId    String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model Task {
  id                String            @id @default(cuid())
  title             String
  description       String?
  status            TaskStatus        @default(A_FAZER)
  priority          TaskPriority      @default(MEDIA)
  startDate         DateTime?
  dueDate           DateTime?
  durationDays      Int?
  isRotina          Boolean           @default(false)
  rotinaFrequencia  RotinaFrequencia?
  projectId         String?
  assigneeId        String?
  parentTaskId      String?
  locked            Boolean           @default(false)
  outlookEventId    String?           @unique
  actualStartedAt   DateTime?
  actualEndedAt     DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  project      Project?               @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignee     User?                  @relation("TaskAssignee", fields: [assigneeId], references: [id])
  parentTask   Task?                  @relation("Subtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks     Task[]                 @relation("Subtasks")
  attachments  Attachment[]
  comments     TaskComment[]
  customFieldValues TaskCustomFieldValue[]
  predecessorLinks TaskDependency[] @relation("DependencySuccessor")
  successorLinks   TaskDependency[] @relation("DependencyPredecessor")

  @@index([projectId])
  @@index([assigneeId])
  @@index([parentTaskId])
  @@index([status])
  @@index([dueDate])
}

enum DependencyType {
  FS
  SS
  FF
  SF
}

// Dependencia de cronograma entre duas tarefas (rede de precedencia, estilo MS Project/Primavera).
// predecessor precisa ocorrer (conforme `type`) antes do sucessor, com `lagDays` de folga/antecedencia.
model TaskDependency {
  id            String         @id @default(cuid())
  predecessorId String
  successorId   String
  type          DependencyType @default(FS)
  lagDays       Int            @default(0)
  createdAt     DateTime       @default(now())

  predecessor Task @relation("DependencyPredecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor   Task @relation("DependencySuccessor", fields: [successorId], references: [id], onDelete: Cascade)

  @@unique([predecessorId, successorId])
  @@index([predecessorId])
  @@index([successorId])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@index([taskId])
}

model Attachment {
  id              String   @id @default(cuid())
  taskId          String?
  teamMessageId   String?
  directMessageId String?
  projectId       String?
  teamId          String?
  folderId        String?
  fileName        String
  filePath        String
  fileSize        Int
  uploadedBy      String
  uploadedAt      DateTime @default(now())

  task          Task?          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  teamMessage   TeamMessage?   @relation(fields: [teamMessageId], references: [id], onDelete: Cascade)
  directMessage DirectMessage? @relation(fields: [directMessageId], references: [id], onDelete: Cascade)
  project       Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  team          Team?          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  folder        Folder?        @relation(fields: [folderId], references: [id], onDelete: Cascade)
  uploader      User           @relation(fields: [uploadedBy], references: [id])

  @@index([taskId])
  @@index([teamMessageId])
  @@index([directMessageId])
  @@index([projectId])
  @@index([teamId])
  @@index([folderId])
}

// Pasta de arquivos de um projeto — organizador hierárquico de documentos/contratos,
// separado dos anexos de chat/tarefa (aba "Arquivos" do projeto).
// projectId OU teamId (nunca os dois) define de quem e a pasta — igual Attachment,
// mais de um dono possivel via FKs opcionais, garantido na camada de API.
model Folder {
  id        String   @id @default(cuid())
  name      String
  projectId String?
  teamId    String?
  parentId  String?
  createdBy String
  createdAt DateTime @default(now())

  project     Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  team        Team?        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  parent      Folder?      @relation("FolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children    Folder[]     @relation("FolderChildren")
  attachments Attachment[]
  creator     User         @relation("FolderCreator", fields: [createdBy], references: [id])

  @@index([projectId])
  @@index([teamId])
  @@index([parentId])
  @@index([createdBy])
}
